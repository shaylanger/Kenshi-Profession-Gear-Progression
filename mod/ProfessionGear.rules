# Exact compatibility rules.
# Explicit exclusions and tags override automatic classification.
#
# exclude|base_item_string_id
# tag|base_item_string_id|TAG1,TAG2
#
# Examples:
# tag|my_mod_iron_hoe|TOOL_FARMING
# tag|my_mod_mining_pack|PACK_ORE
# tag|my_mod_cargo_frame|PACK_HAULING
# tag|my_mod_assassin_blade|ASSASSIN_GEAR
# tag|my_mod_diving_suit|SWIM_GEAR
# exclude|my_mod_decorative_pickaxe
